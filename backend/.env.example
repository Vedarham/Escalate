# ---------------------------------------------------------------
# Escalate - backend configuration
# Copy this file to `.env` and fill in at least one API key.
# Never commit your real .env file.
# ---------------------------------------------------------------

# Primary provider: "groq" or "huggingface".
# If the primary fails (rate limit, outage) and the other key is set,
# the backend automatically falls back to the other provider.
LLM_PROVIDER=groq

# Groq (free tier) - https://console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_TEXT_MODEL=openai/gpt-oss-120b
# light model for simple steps (legal agent planner) - separate free-tier rate limit
GROQ_FAST_MODEL=openai/gpt-oss-20b

# Hugging Face Inference Providers (free monthly credits) - https://huggingface.co/settings/tokens
HF_TOKEN=
HF_BASE_URL=https://router.huggingface.co/v1
HF_VISION_MODEL=Qwen/Qwen3.8-27B
HF_TEXT_MODEL=Qwen/Qwen3.8-27B
HF_FAST_MODEL=Qwen/Qwen3.8-27B

# Force deterministic demo responses even when keys are present (true/false).
# When no key is configured at all, demo mode is enabled automatically.
DEMO_MODE=false

# If every live provider fails (rate limit, no credits, outage), serve clearly
# labelled demo data instead of an error. Handy for presentations.
FALLBACK_TO_DEMO=false

# Request limits
MAX_IMAGE_MB=8
LLM_TIMEOUT_SECONDS=90
LLM_TEMPERATURE=0.2

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Storage (SQLite history + uploaded images). On Vercel this is always under /tmp (ephemeral).
STORAGE_DIR=storage
